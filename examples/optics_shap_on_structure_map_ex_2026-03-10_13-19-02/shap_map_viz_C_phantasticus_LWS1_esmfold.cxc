camera ortho
open C_phantasticus_LWS1_esmfold_shap_comparison_mapped.pdb
zoom 0.55
move x -10
hide atoms
hide cartoons
show /A cartoons
light gentle
graphics silhouettes true width 1.5
color byattribute bfactor /A palette #5ab4ac:#f5f5f5:#ef8a62 range 0,100
set bgColor black
# Delete the next line if you don't wont the surface loaded...
surface /A
transparency 95 target s
key #5ab4ac:0 #f5f5f5:50 #ef8a62:100 pos 0.78,0.2 size 0.035,0.55 justification left labelOffset 5
2dlab text 'Norm. SHAP Importance' size 30 xpos .62 ypos .10
# NOTE: B-factors now represent ML Feature Importance (0=Low, 100=High)

# --- Top SHAP Site Labels ---
label /A:283 text '269'
show /A:283 atoms
label /A:222 text '208'
show /A:222 atoms
label /A:275 text '261'
show /A:275 atoms
label /A:178 text '164'
show /A:178 atoms
label /A:44 text '30'
show /A:44 atoms
label /A:231 text '217'
show /A:231 atoms
label /A:180 text '166'
show /A:180 atoms
label /A:289 text '275'
show /A:289 atoms
label /A:109 text '95'
show /A:109 atoms
label /A:164 text '150'
show /A:164 atoms
label color white
label height 3.0
